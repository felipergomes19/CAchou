# Modelo das variáveis de ambiente do backend. Copie para ".env" (que NÃO vai para o git) e preencha.
# O Spring Boot não lê arquivo .env sozinho: exporte as variáveis no terminal/IDE/painel da nuvem.

# --- Banco PostgreSQL (use ACHOU_DB_URL OU as partes separadas) ---
# ACHOU_DB_URL=jdbc:postgresql://HOST:5432/BANCO?sslmode=require
ACHOU_DB_HOST=localhost
ACHOU_DB_PORT=5432
ACHOU_DB_NAME=achou
ACHOU_DB_USER=achou
ACHOU_DB_PASSWORD=troque-esta-senha
# Bancos em nuvem costumam exigir SSL:
ACHOU_DB_SSLMODE=prefer

# --- Segurança (obrigatório em produção; mínimo de 32 caracteres) ---
ACHOU_JWT_SECRET=gere-um-segredo-longo-e-aleatorio-aqui

# --- E-mail de recuperação de senha (SMTP) ---
ACHOU_MAIL_ENABLED=false
ACHOU_MAIL_HOST=smtp.gmail.com
ACHOU_MAIL_PORT=587
ACHOU_MAIL_USER=seu.email@gmail.com
# Gmail: use uma "senha de app" (exige verificação em duas etapas), nunca a senha normal da conta.
ACHOU_MAIL_PASSWORD=
ACHOU_MAIL_FROM=seu.email@gmail.com
# Porta 465 (SSL direto):  ACHOU_MAIL_SSL=true  e  ACHOU_MAIL_STARTTLS=false
